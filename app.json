{
  "expo": {
    "name": "ibe-mobile",
    "slug": "ibe-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/ibe-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/images/ibe-splash-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibe2023.ibemobile",
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/ibe-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ibe2023.ibemobile",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bb0df582-2438-44a1-82a2-5a4a7ec2de5c",
        "EAS_NO_VCS=1": 1
      }
    },
    "owner": "ibe-2023",
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./src/assets/images/ibe-splash-white.png",
          "dark": {
            "image": "./src/assets/images/ibe-splash-white.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset"
    ]
  }
}
